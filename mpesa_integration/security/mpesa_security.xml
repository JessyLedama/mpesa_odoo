<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- M-Pesa User Group -->
    <record id="group_mpesa_user" model="res.groups">
        <field name="name">M-Pesa User</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Users who can view M-Pesa transactions and initiate payments.</field>
    </record>

    <!-- M-Pesa Manager Group -->
    <record id="group_mpesa_manager" model="res.groups">
        <field name="name">M-Pesa Manager</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_mpesa_user'))]"/>
        <field name="comment">Users who can configure M-Pesa settings and manage all transactions.</field>
    </record>

    <!-- M-Pesa Configuration Record Rules -->
    <record id="mpesa_config_rule_user" model="ir.rule">
        <field name="name">M-Pesa Config: User sees own company configs</field>
        <field name="model_id" ref="model_mpesa_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mpesa_user'))]"/>
    </record>

    <!-- M-Pesa Transaction Record Rules -->
    <record id="mpesa_transaction_rule_user" model="ir.rule">
        <field name="name">M-Pesa Transaction: User sees own company transactions</field>
        <field name="model_id" ref="model_mpesa_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mpesa_user'))]"/>
    </record>

</odoo>
