<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default M-Pesa Configuration Data -->
    <!-- This creates helpful initial values for users -->

    <!-- Cron job to check pending transactions -->
    <record id="ir_cron_mpesa_check_pending" model="ir.cron">
        <field name="name">M-Pesa: Check Pending Transactions</field>
        <field name="model_id" ref="model_mpesa_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_pending_transactions()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

</odoo>
