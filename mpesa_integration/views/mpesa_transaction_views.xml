<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- M-Pesa Transaction Form View -->
    <record id="view_mpesa_transaction_form" model="ir.ui.view">
        <field name="name">mpesa.transaction.form</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <form string="M-Pesa Transaction" create="0">
                <header>
                    <button name="action_query_status" 
                            string="Query Status" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'pending' or transaction_type != 'stk_push'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_view_invoice" icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <span>Invoice</span>
                        </button>
                        <button class="oe_stat_button" type="object" 
                                name="action_view_payment" icon="fa-money"
                                invisible="not payment_id">
                            <span>Payment</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger" invisible="state != 'failed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-warning" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="display_name"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Transaction Details">
                            <field name="transaction_type"/>
                            <field name="phone_number"/>
                            <field name="amount"/>
                            <field name="account_reference"/>
                            <field name="description"/>
                            <field name="transaction_date"/>
                        </group>
                        <group string="Status">
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'completed'"
                                   decoration-danger="state == 'failed'"
                                   decoration-warning="state == 'cancelled'"
                                   decoration-info="state == 'pending'"/>
                            <field name="result_code"/>
                            <field name="result_description"/>
                        </group>
                    </group>
                    <group>
                        <group string="M-Pesa References">
                            <field name="mpesa_receipt_number"/>
                            <field name="checkout_request_id"/>
                            <field name="merchant_request_id"/>
                            <field name="transaction_id"/>
                        </group>
                        <group string="Related Records">
                            <field name="config_id"/>
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="payment_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Callback Data" name="callback_data" groups="base.group_no_one">
                            <field name="callback_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- M-Pesa Transaction Tree View -->
    <record id="view_mpesa_transaction_tree" model="ir.ui.view">
        <field name="name">mpesa.transaction.tree</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <tree string="M-Pesa Transactions" create="0" decoration-success="state == 'completed'" decoration-danger="state == 'failed'" decoration-warning="state == 'cancelled'" decoration-muted="state == 'pending'">
                <field name="create_date" string="Date"/>
                <field name="mpesa_receipt_number"/>
                <field name="transaction_type"/>
                <field name="phone_number"/>
                <field name="amount" sum="Total"/>
                <field name="account_reference"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'cancelled'"
                       decoration-info="state == 'pending'"/>
                <field name="company_id" groups="base.group_multi_company" column_invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- M-Pesa Transaction Search View -->
    <record id="view_mpesa_transaction_search" model="ir.ui.view">
        <field name="name">mpesa.transaction.search</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <search string="Search M-Pesa Transactions">
                <field name="mpesa_receipt_number"/>
                <field name="phone_number"/>
                <field name="account_reference"/>
                <field name="checkout_request_id"/>
                <field name="invoice_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="STK Push" name="stk_push" domain="[('transaction_type', '=', 'stk_push')]"/>
                <filter string="C2B" name="c2b" domain="[('transaction_type', '=', 'c2b')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '>=', time.strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('create_date', '>=', (context_today() - relativedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('create_date', '>=', time.strftime('%%Y-%%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Invoice" name="group_invoice" context="{'group_by': 'invoice_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- M-Pesa Transaction Action -->
    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">M-Pesa Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mpesa_transaction_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No M-Pesa transactions yet
            </p>
            <p>
                Transactions will appear here when customers make payments via M-Pesa.
            </p>
        </field>
    </record>
    
    <!-- Completed Transactions Action -->
    <record id="action_mpesa_transaction_completed" model="ir.actions.act_window">
        <field name="name">Completed Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mpesa_transaction_search"/>
        <field name="domain">[('state', '=', 'completed')]</field>
    </record>
    
    <!-- Pending Transactions Action -->
    <record id="action_mpesa_transaction_pending" model="ir.actions.act_window">
        <field name="name">Pending Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mpesa_transaction_search"/>
        <field name="domain">[('state', '=', 'pending')]</field>
    </record>
</odoo>
