<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Invoice Form View to add M-Pesa button -->
    <record id="view_move_form_mpesa" model="ir.ui.view">
        <field name="name">account.move.form.mpesa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add M-Pesa button in header -->
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_mpesa_stk_push"
                        string="Request M-Pesa Payment"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted' or payment_state == 'paid' or move_type not in ['out_invoice', 'in_invoice']"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- Add M-Pesa transactions stat button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mpesa_transactions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-mobile"
                        invisible="mpesa_transaction_count == 0">
                    <field name="mpesa_transaction_count" widget="statinfo" string="M-Pesa"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Inherit Invoice Tree View to show M-Pesa indicator -->
    <record id="view_move_tree_mpesa" model="ir.ui.view">
        <field name="name">account.move.tree.mpesa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="mpesa_transaction_count" string="M-Pesa" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
